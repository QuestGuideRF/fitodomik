{
  "profile_id": "dht11_default",
  "sensor_type": "dht11",
  "name": "DHT11",
  "connection": "digital",
  "library_required": true,
  "library_name": "DHT sensor library",
  "library_names": [
    "DHT sensor library"
  ],
  "includes": [
    "#include <DHT.h>"
  ],
  "constructor_template": "DHT {var_name}({pin}, DHT11);",
  "setup_template": "{var_name}.begin();",
  "read_templates": [
    {
      "key": "temperature",
      "unit": "°C",
      "code": "{var_name}.readTemperature()"
    },
    {
      "key": "humidity",
      "unit": "%",
      "code": "{var_name}.readHumidity()"
    }
  ],
  "template_status": "library_required"
}