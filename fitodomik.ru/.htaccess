RewriteEngine On
RewriteBase /
DirectoryIndex index.php index.html
# Runtime PID, heartbeat and logs are never public.
RewriteRule ^(?:runtime|logs)(?:/|$) - [F,L,NC]
# Canonical host fallback. HTTPS is terminated and redirected by the front-end
# nginx server, so checking %{HTTPS} here would redirect proxied HTTPS requests
# back to themselves.
RewriteCond %{HTTP_HOST} ^www\.fitodomik\.ru(?::[0-9]+)?$ [NC]
RewriteRule ^ https://fitodomik.ru%{REQUEST_URI} [R=308,L,NE]
# Индексные страницы не должны быть дублями главной.
RewriteCond %{THE_REQUEST} \s/+index\.(?:php|html?) [NC]
RewriteRule ^index\.(?:php|html?)$ / [R=301,L,NE]
# Исторический домен проекта.
RewriteCond %{HTTP_HOST} ^farm429\.ru$ [NC]
RewriteRule ^ https://fitodomik.ru%{REQUEST_URI} [R=308,L,NE]
# Старый домен кабинета: API сохраняет метод запроса, страницы переезжают на fitodomik.ru.
RewriteCond %{HTTP_HOST} ^(?:www\.)?fitodomik(?:2)?\.online$ [NC]
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ https://fitodomik.ru%{REQUEST_URI} [R=308,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?fitodomik(?:2)?\.online$ [NC]
RewriteRule ^ https://fitodomik.ru%{REQUEST_URI} [R=301,L,NE]
# Versioned public asset URLs keep the extension aligned with the response
# MIME type while static.php remains the single validated file handler.
RewriteRule ^static/css/style\.v([0-9]+)\.css$ static.php?asset=style-css&v=$1 [L,QSA,NC]
RewriteRule ^static/css/bootstrap\.v([0-9]+)\.css$ static.php?asset=bootstrap-css&v=$1 [L,QSA,NC]
RewriteRule ^static/css/bootstrap-icons\.v([0-9]+)\.css$ static.php?asset=bootstrap-icons-css&v=$1 [L,QSA,NC]
RewriteRule ^static/js/bootstrap\.v([0-9]+)\.js$ static.php?asset=bootstrap-js&v=$1 [L,QSA,NC]
RewriteRule ^static/js/theme\.v([0-9]+)\.js$ static.php?asset=theme-js&v=$1 [L,QSA,NC]
RewriteRule ^static/js/deferred-icons\.v([0-9]+)\.js$ static.php?asset=deferred-icons-js&v=$1 [L,QSA,NC]
RewriteRule ^static/js/model-viewer\.v([0-9]+)\.js$ static.php?asset=model-viewer-js&v=$1 [L,QSA,NC]
RewriteRule ^static/js/components-scroll\.v([0-9]+)\.js$ static.php?asset=components-scroll-js&v=$1 [L,QSA,NC]
RewriteRule ^static/fonts/manrope\.v([0-9]+)\.woff2$ static.php?asset=manrope-font&v=$1 [L,QSA,NC]
RewriteRule ^static/fonts/unbounded\.v([0-9]+)\.woff2$ static.php?asset=unbounded-font&v=$1 [L,QSA,NC]
RewriteRule ^static/fonts/bootstrap-icons\.v([0-9]+)\.woff2$ static.php?asset=bootstrap-icons-font&v=$1 [L,QSA,NC]
RewriteRule ^static/fonts/bootstrap-icons\.v([0-9]+)\.woff$ static.php?asset=bootstrap-icons-font-woff&v=$1 [L,QSA,NC]
RewriteRule ^static/images/hero\.v([0-9]+)\.png$ static.php?asset=hero-png&v=$1 [L,QSA,NC]
RewriteRule ^static/images/hero\.v([0-9]+)\.avif$ static.php?asset=hero-avif&v=$1 [L,QSA,NC]
RewriteRule ^static/images/hero\.v([0-9]+)\.webp$ static.php?asset=hero-webp&v=$1 [L,QSA,NC]
RewriteRule ^static/images/telegram-qr\.v([0-9]+)\.webp$ static.php?asset=telegram-qr&v=$1 [L,QSA,NC]
RewriteRule ^static/images/site-qr\.v([0-9]+)\.webp$ static.php?asset=site-qr&v=$1 [L,QSA,NC]
RewriteRule ^static/gallery/(.+)\.v([0-9]+)\.(png|jpe?g|webp|avif)$ static.php?asset=gallery-image&file=$1.$3&v=$2 [B,L,QSA,NC]
RewriteRule ^static/models/(.+)\.v([0-9]+)\.(glb|gltf|stl)$ static.php?asset=model-file&file=$1.$3&v=$2 [B,L,QSA,NC]
RewriteRule ^static/models/resources/(.+)\.v([0-9]+)\.(bin|png|jpe?g|webp)$ static.php?asset=model-file&file=$1.$3&v=$2 [B,L,QSA,NC]
RewriteRule ^static/components/frame-((?:0[1-9]|1[0-9]|2[0-7]))\.v([0-9]+)\.webp$ static.php?asset=component-frame&frame=$1&v=$2 [L,QSA,NC]
RewriteRule ^static/icon/apple-touch-icon\.v([0-9]+)\.png$ static.php?asset=apple-touch-icon&v=$1 [L,QSA,NC]
RewriteRule ^static/icon/favicon-32x32\.v([0-9]+)\.png$ static.php?asset=favicon-32&v=$1 [L,QSA,NC]
RewriteRule ^static/icon/favicon-16x16\.v([0-9]+)\.png$ static.php?asset=favicon-16&v=$1 [L,QSA,NC]
RewriteRule ^static/icon/favicon\.v([0-9]+)\.ico$ static.php?asset=favicon&v=$1 [L,QSA,NC]
RewriteRule ^static/icon/android-chrome-192x192\.v([0-9]+)\.png$ static.php?asset=android-icon-192&v=$1 [L,QSA,NC]
RewriteRule ^static/icon/android-chrome-512x512\.v([0-9]+)\.png$ static.php?asset=android-icon-512&v=$1 [L,QSA,NC]
RewriteRule ^site\.v([0-9]+)\.webmanifest$ static.php?asset=manifest&v=$1 [L,QSA,NC]
RewriteRule ^static/css/([A-Za-z0-9_-]+)\.v([0-9]+)\.css$ security/css.php?file=$1.css&v=$2 [L,QSA,NC]
RewriteRule ^static/js/((?:lib/)?[A-Za-z0-9_.-]+)\.v([0-9]+)\.js$ security/js.php?file=$1.js&v=$2 [L,QSA,NC]
RewriteRule ^static/icon/([A-Za-z0-9_-]+)\.v([0-9]+)\.(png|ico|svg|webp)$ security/image.php?file=icon/$1.$3&v=$2 [L,QSA,NC]
RewriteRule ^media/avatars/([A-Za-z0-9._-]+)$ security/image.php?file=avatars/$1 [L,QSA,NC]
RewriteRule ^media/farm_photos/([A-Za-z0-9._-]+)$ security/image.php?file=farm_photos/$1 [L,QSA,NC]
RewriteRule ^api/get-farm-status\.json$ api/get-farm-status.php [L,QSA,NC]
RewriteRule ^api/load-planting-events\.json$ api/load-planting-events.php [L,QSA,NC]
RewriteRule ^api/device-day-summary\.json$ api/device-day-summary.php [L,QSA,NC]
RewriteCond %{THE_REQUEST} \s/+author/index\.php(?:[?\s]) [NC]
RewriteRule ^author/index\.php$ /author [R=301,L,NE]
RewriteRule ^author/?$ author/index.php [L,QSA,NC]
RewriteRule ^pages/(news|info|galery|components|code|feedback|device|plant-catalog)/?$ pages/$1/index.php [L,QSA,NC]
RewriteRule ^pages/about/?$ /pages/info/ [R=301,L,NE]
RewriteRule ^pages/gallery/?$ /pages/galery/ [R=301,L,NE]
RewriteRule ^pages/components/([A-Za-z0-9_-]+)/?$ pages/components/$1/index.php [L,QSA,NC]
RewriteRule ^uploads/avatars/(.+)\.(jpg|jpeg|png|gif|webp)$ security/image.php?file=avatars/$1.$2 [L,QSA,NC]
RewriteRule ^uploads/farm_photos/(.+)\.(jpg|jpeg|png|gif|webp)$ security/image.php?file=farm_photos/$1.$2 [L,QSA,NC]
RewriteRule ^site\.webmanifest$ static.php?asset=manifest [L,QSA,NC]
# Заголовки HTML и общая защита MIME-sniffing
SetEnvIf Request_URI "^/(admin|install)(/|$)" private_page=1
SetEnvIf Request_URI "^/auth/(?!login\.php(?:$|[/?])|register\.php(?:$|[/?]))" private_page=1
SetEnvIf Request_URI "^/auth/(?:login|register)\.php(?:$|[/?])" auth_form_page=1
SetEnvIf Request_URI "^/authentication/api/" private_page=1 no_csp_response=1
SetEnvIf Request_URI "^/(?:api|static|media|uploads)/" no_csp_response=1
<IfModule mod_headers.c>
    # Replace both Apache header tables to avoid duplicate policies from PHP.
    Header unset Cross-Origin-Embedder-Policy
    Header always unset Cross-Origin-Embedder-Policy
    Header always set Cross-Origin-Embedder-Policy "credentialless"
    Header unset Cross-Origin-Opener-Policy
    Header always unset Cross-Origin-Opener-Policy
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header unset Cross-Origin-Resource-Policy
    Header always unset Cross-Origin-Resource-Policy
    Header always set Cross-Origin-Resource-Policy "same-site"
    Header unset Permissions-Policy
    Header always unset Permissions-Policy
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
    Header unset X-Frame-Options
    Header always unset X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"
    <FilesMatch "^(?!(?:static|css|js|image)\.php$).*\.(?:php|html?)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.com https://www.google-analytics.com; font-src 'self' data:; connect-src 'self' blob: https://mc.yandex.ru https://mc.yandex.com https://www.google-analytics.com https://region1.google-analytics.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" env=!no_csp_response
        Header unset Cache-Control
        Header always unset Cache-Control
        Header always set Cache-Control "no-cache" env=!private_page
        Header always set Cache-Control "no-store, no-cache, must-revalidate" env=private_page
        Header always set Cache-Control "private, no-cache" env=auth_form_page
        Header always unset Pragma
        Header always unset Expires
    </FilesMatch>
</IfModule>
# Запрещаем доступ к секретам, служебным скриптам, дампам, логам и резервным копиям
<FilesMatch "(^\.|\.sh$|\.log$|\.sql$|\.sqlite3?$|\.bak$|\.backup$|\.dist$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
# Set correct MIME types
AddType "text/css; charset=utf-8" .css
AddType "application/javascript; charset=utf-8" .js
AddType "application/json; charset=utf-8" .json
AddType application/xml .xml
AddType "application/manifest+json; charset=utf-8" .webmanifest
<Files "sitemap.xml">
    ForceType application/xml
    <IfModule mod_headers.c>
        Header set Content-Type "application/xml; charset=utf-8"
        Header set Cache-Control "public, max-age=3600"
    </IfModule>
</Files>
<Files "llms.txt">
    ForceType text/markdown
    <IfModule mod_headers.c>
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set Cache-Control "public, max-age=3600"
        Header set X-Content-Type-Options "nosniff"
        Header unset Content-Security-Policy
    </IfModule>
</Files>
AddType application/vnd.ms-fontobject .eot
AddType font/ttf .ttf
AddType font/otf .otf
AddType font/woff .woff
AddType font/woff2 .woff2
AddType model/gltf-binary .glb
AddType model/gltf+json .gltf
AddType model/stl .stl
AddType application/octet-stream .bin
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff|woff2|png|jpg|jpeg|gif|svg|webp|avif|ico|glb|gltf|stl|bin|webmanifest)$">
    Header unset Expires
    Header always unset Expires
    Header unset Pragma
    Header always unset Pragma
    Header unset Content-Security-Policy
    Header always unset Content-Security-Policy
    Header unset X-XSS-Protection
    Header always unset X-XSS-Protection
    Header unset X-Frame-Options
    Header always unset X-Frame-Options
    Header unset X-Content-Type-Options
    Header always unset X-Content-Type-Options
    Header unset Cache-Control
    Header always unset Cache-Control
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Content-Type "text/css; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Content-Type "application/javascript; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header set Content-Type "application/manifest+json; charset=utf-8"
  </FilesMatch>
</IfModule>
# Запрет доступа к системным директориям
RedirectMatch 403 ^/.git/.*$
RedirectMatch 403 ^/includes/.*$
RedirectMatch 403 ^/config/.*$
RedirectMatch 403 ^/vendor/.*$
RedirectMatch 403 ^/composer\.(?:json|lock)$
# Обработка ошибок
ErrorDocument 400 /404.php
ErrorDocument 401 /404.php
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php
ErrorDocument 500 /404.php
# Основные правила маршрутизации
RewriteRule ^sitemap-images\.xml$ sitemap-images.php [L]
# Если файл не найден, перенаправляем на 404.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /404.php [L] 
