Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>

<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>
<Files "env_loader.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "database.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "schema.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "telegram.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "telegram_bot_common.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "telegram_bot_features.php">
    Order Allow,Deny
    Deny from all
</Files>
